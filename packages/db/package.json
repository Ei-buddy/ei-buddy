{
  "name": "@na-regua/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint src",
    "migrate": "tsx --env-file-if-exists=../../.env src/bin/migrate.ts",
    "super-admin": "tsx --env-file-if-exists=../../.env src/bin/bootstrap-super-admin.ts"
  },
  "dependencies": {
    "@na-regua/contracts": "workspace:*",
    "@na-regua/core": "workspace:*",
    "@na-regua/env": "workspace:*",
    "@na-regua/fiscal": "workspace:*",
    "@na-regua/money": "workspace:*",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
