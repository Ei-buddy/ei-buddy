# =============================================================================
# Ambiente de desenvolvimento local.
#
#   cp .env.example .env      (ou: pnpm setup, que faz isso e sobe a infra)
#
# NUNCA versione o .env. NUNCA use credencial de producao aqui (RNF-070).
# A matriz completa de variaveis esta em docs/engenharia/ambientes.md
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug
TZ=America/Sao_Paulo

# --- Infraestrutura local (casa com infra/docker-compose.yml) ---------------

POSTGRES_USER=naregua
POSTGRES_PASSWORD=naregua
POSTGRES_DB=naregua
POSTGRES_PORT=5432
REDIS_PORT=6379

# NAO e o POSTGRES_USER acima, e a diferenca e proposital: aquele e o dono do
# banco, e dono e superusuario — superusuario IGNORA a RLS, entao o isolamento
# entre empresas nao valeria. A api recusa subir se detectar isso.
DATABASE_URL=postgresql://naregua_app:naregua@localhost:5432/naregua
# Papel separado, com BYPASSRLS — so para migrations (docs/arquitetura/dados.md)
DATABASE_MIGRATION_URL=postgresql://naregua_migrator:naregua@localhost:5432/naregua
REDIS_URL=redis://localhost:6379

# --- Aplicacoes -------------------------------------------------------------

API_PORT=3333
API_URL=http://localhost:3333
WEB_PORT=3000

# --- Perfil "full" do docker compose ----------------------------------------

MINIO_USER=naregua
MINIO_PASSWORD=naregua123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# =============================================================================
# Provedores externos
#
# Provedores: fake no local. Staging/producao escolhem o adapter (ADR).
# Sem credencial, o sistema sobe. Ver docs/decisoes/README.md.
# =============================================================================

# --- PSP e assinatura: Asaas (ADR-0004) — docs/arquitetura/integracoes/asaas.md
PAYMENTS_PROVIDER=fake
BILLING_PROVIDER=fake
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_USER_AGENT=NaRegua/dev
ASAAS_WEBHOOK_AUTH_TOKEN=
# walletId da conta-pai — so se DEC-018 escolher Split
ASAAS_WALLET_ID=

# --- Assinatura: prazos (RF-110, RF-116) ------------------------------------
# VAZIOS DE PROPOSITO. Periodo de teste, aviso e tolerancia sao a QST-002,
# ainda em aberto (DEC-010) — um numero aqui seria decisao de produto tomada
# num arquivo de configuracao. Enquanto vazios, a empresa nasce SEM assinatura
# e continua lancando normalmente; os quatro precisam ser preenchidos juntos.
BILLING_TRIAL_DAYS=
BILLING_TRIAL_WARNING_DAYS=
BILLING_GRACE_DAYS=
BILLING_TRIAL_PLAN=

# --- WhatsApp: Meta Cloud API (ADR-0014) ------------------------------------
WHATSAPP_PROVIDER=fake
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

# --- Fiscal (DEC-004) -------------------------------------------------------
FISCAL_PROVIDER=fake
FISCAL_API_TOKEN=
FISCAL_ENVIRONMENT=homologacao

# --- Open Finance (DEC-005) -------------------------------------------------
BANKING_PROVIDER=fake
BANKING_CLIENT_ID=
BANKING_CLIENT_SECRET=

# --- LLM (ADR-0010) / harness NR-060 + Studio NR-121 ------------------------
#
# Harness HTTP: POST /agent/messages com sessao de fixture (usuario + empresa
# de teste). Nao e canal de produto do lojista. Passo a passo:
# specs/002-agent-mastra-runtime/quickstart.md
#
# Harness Studio (NR-121): agent-rele `studio-harness` → processMessage
# (channel whatsapp, peer forjado). Sem /api/agents de negocio. Passo a passo:
# specs/003-studio-harness/quickstart.md — `pnpm studio`.
#
# `fake` e o modo LOCAL: nao chama a OpenAI, e por isso ninguem precisa de
# chave para subir o sistema. EM PRODUCAO ele nao e servido — deixe
# AGENT_PROVIDER=mastra com OPENAI_API_KEY preenchida, senao o assistente sobe
# desligado (`/agent/messages` responde 503, Studio nao monta, e o log avisa).
# O resto da api funciona normalmente nos dois casos.
AGENT_PROVIDER=fake
OPENAI_API_KEY=
AGENT_MODEL=openai/gpt-4o-mini
# Teto mensal de IA por empresa, em centavos (RNF-073). Vazio = sem teto.
AGENT_MONTHLY_BUDGET_CENTS=
# Porteiro (FR-001b): `1` libera HTTP e Studio quando NODE_ENV esta proximo de
# producao (ex. staging). Ausente/vazio = so nao-producao. Em producao o
# default e off; `fake` continua barrado.
AGENT_HARNESS=
# Path do JSON de presets do Studio. Ausente/vazio =
# packages/agent/studio/presets.json. Copie presets.example.json, preencha
# UUIDs da fixture. IDs reais nao entram no git.
AGENT_STUDIO_PRESETS=

# --- Autenticacao (ADR-0002) ------------------------------------------------
#
# `fake` guarda a credencial em `.dev/identidades.json` com scrypt e serve ao
# desenvolvimento. `better-auth` e o provedor de verdade (opcao D da ADR): as
# tabelas dele ficam no schema `identidade`, criadas por
# `pnpm --filter @na-regua/api migrar:identidade` DEPOIS de `pnpm db:migrate`.
#
# Producao recusa subir com `fake` — ver `assertAuthUsavelEmProducao`.
AUTH_PROVIDER=fake
JWT_SECRET=dev-only-nao-use-em-producao-troque-isto

# Obrigatoria quando AUTH_PROVIDER=better-auth, e ignorada com `fake`.
# 32+ caracteres aleatorios:  node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# =============================================================================
# Webhooks em desenvolvimento
#
# Provedores exigem URL HTTPS publica — localhost e recusado no cadastro
# (vale para Asaas e para WhatsApp). Use um tunel:
#
#   cloudflared tunnel --url http://localhost:3333
#   ngrok http 3333
#
# e cadastre a URL gerada no portal do provedor.
# =============================================================================
PUBLIC_WEBHOOK_URL=

# Cifra os segredos de lojista guardados em coluna — RF-004, RNF-022.
# 32 bytes em base64. Gere com: openssl rand -base64 32
# Obrigatoria apenas com FISCAL_PROVIDER=focusnfe.
SECRETS_KEY=

# Acesso provisorio a /admin/lista-vip* sem sessao, antes de existir o
# primeiro Super Admin — NR-111. Vazia desliga esse caminho por completo.
# Gere com: openssl rand -base64 32
WAITLIST_ADMIN_KEY=

# De onde sai a nota fiscal — DEC-004. `fake` nao emite nada.
FISCAL_PROVIDER=fake
# Homologacao NAO tem validade fiscal.
FISCAL_AMBIENTE=homologacao
