{
  "name": "@na-regua/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint src"
  },
  "dependencies": {
    "@na-regua/contracts": "workspace:*",
    "@na-regua/core": "workspace:*",
    "@na-regua/db": "workspace:*",
    "@na-regua/env": "workspace:*",
    "@na-regua/fiscal": "workspace:*",
    "@na-regua/money": "workspace:*",
    "@na-regua/whatsapp": "workspace:*",
    "bullmq": "^6.3.8",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
