{
  "name": "@na-regua/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "migrar:identidade": "tsx --env-file-if-exists=../../.env src/bin/migrar-identidade.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint src",
    "studio": "tsx --env-file-if-exists=../../.env ./scripts/studio.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@mastra/fastify": "1.5.10",
    "@na-regua/agent": "workspace:*",
    "@na-regua/banking": "workspace:*",
    "@na-regua/billing": "workspace:*",
    "@na-regua/contracts": "workspace:*",
    "@na-regua/core": "workspace:*",
    "@na-regua/db": "workspace:*",
    "@na-regua/env": "workspace:*",
    "@na-regua/fiscal": "workspace:*",
    "@na-regua/money": "workspace:*",
    "@na-regua/payments": "workspace:*",
    "@na-regua/whatsapp": "workspace:*",
    "better-auth": "^1.7.4",
    "bullmq": "^6.3.4",
    "fastify": "^5.12.4",
    "ioredis": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "mastra": "1.30.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
