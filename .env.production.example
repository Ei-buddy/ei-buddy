# =============================================================================
# .env.production — modelo
#
#   cp .env.production.example .env.production   (na raiz, fora do git)
#
# UM arquivo serve TODOS os containers: `docker-compose.prod.yml` aponta
# `env_file: ../.env.production` em postgres, redis, api, worker e web.
#
# ## Por que este arquivo existe, e nao "copie o .env.example"
#
# Porque copiar o `.env.example` QUEBRA a producao, e ja quebrou duas vezes.
# Ele e o exemplo de DESENVOLVIMENTO: entrega `AUTH_PROVIDER=fake`,
# `AGENT_PROVIDER=fake` e `JWT_SECRET=dev-only-...` — valores que a api recusa
# ou que nao deveriam existir num servidor. Quem monta producao a partir dele
# recebe um container em laco de reinicio e um 502 sem explicacao.
#
# Cada bloco abaixo diz o que muda em relacao ao desenvolvimento, e por que.
# =============================================================================


# --- Banco de dados (container postgres) -------------------------------------
#
# Lidas pela IMAGEM do Postgres na primeira subida, e pelo healthcheck.
# Trocar depois que o volume existe nao tem efeito: so valem na criacao.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROQUE-esta-senha
POSTGRES_DB=naregua


# --- Ambiente ----------------------------------------------------------------
#
# `production` nao e enfeite: e ele que liga as guardas que recusam subir com
# provedor falso (AUTH_PROVIDER). Deixar `development` num servidor faria a api
# subir aceitando QUALQUER senha no login.
NODE_ENV=production
LOG_LEVEL=info
TZ=America/Sao_Paulo


# --- Conexoes com o banco ----------------------------------------------------
#
# DOIS papeis, e a diferenca entre eles e de seguranca, nao de estilo:
#
#   naregua_app      — sem BYPASSRLS. E o da APLICACAO.
#   naregua_migrator — com BYPASSRLS. So para migrations.
#
# Os dois sao criados por `infra/postgres/init/01-extensions.sql` na primeira
# subida do volume.
#
# Pondo o migrator (ou `postgres`) em DATABASE_URL, a api NAO SOBE: ela confere
# no boot se a propria conexao esta sujeita a RLS e recusa servir se nao
# estiver — uma consulta sem RLS devolve as linhas de todas as lojas, sem erro
# nenhum. Ja aconteceu num ambiente real, e so a CI notou.
#
# ATENCAO: o script de init cria os dois papeis com a senha 'naregua' fixa, que
# esta versionada neste repositorio. Para producao, TROQUE a senha dos dois
# papeis no banco (ALTER ROLE ... PASSWORD) e reflita aqui.
DATABASE_URL=postgresql://naregua_app:TROQUE-esta-senha@postgres:5432/naregua
DATABASE_MIGRATION_URL=postgresql://naregua_migrator:TROQUE-esta-senha@postgres:5432/naregua

# `redis` e `postgres` sao os nomes dos servicos na rede do compose — nao
# `localhost`, que dentro do container aponta para o proprio container.
REDIS_URL=redis://redis:6379


# --- API ---------------------------------------------------------------------
#
# API_URL e a URL PUBLICA da api (o Caddy expoe api.eibuddy.com.br). Nao e por
# onde o web chama: o compose ja injeta `API_URL=http://api:3333` no container
# do web, pela rede interna.
API_PORT=3333
API_URL=https://api.eibuddy.com.br
# Onde a web mora: vai no link do e-mail de redefinir senha.
WEB_URL=https://eibuddy.com.br


# --- Autenticacao (DEC-008) --------------------------------------------------
#
# `fake` ACEITA QUALQUER CREDENCIAL. Em producao a api recusa subir com ele —
# e essa recusa e a causa mais provavel de um 502 depois de copiar o
# `.env.example`.
#
# BETTER_AUTH_SECRET e obrigatoria quando AUTH_PROVIDER=better-auth, com no
# minimo 32 caracteres. Sem ela a biblioteca geraria um segredo por processo:
# duas instancias assinariam diferente, e todo reinicio derrubaria as sessoes.
#
#   openssl rand -base64 48
AUTH_PROVIDER=better-auth
BETTER_AUTH_SECRET=

# Assina a sessao. NUNCA reaproveite o valor do .env.example.
#
#   openssl rand -base64 48
JWT_SECRET=


# --- Cifragem de segredos do lojista (RNF-022) -------------------------------
#
# 32 bytes em base64. Opcional: sem ela a api SOBE e so a tela de configuracao
# fiscal fica indisponivel — melhor que nao subir. Mas sem ela ninguem emite
# nota, entao defina antes de abrir para lojista de verdade.
#
#   openssl rand -base64 32
SECRETS_KEY=


# --- Assistente de IA (ADR-0010) ---------------------------------------------
#
# Opcional desde a correcao do laco de reinicio: sem chave, a api sobe e so
# `/agent/messages` responde 503. O `fake` nao e servido em producao — ele
# reconhece tres frases e seria um assistente de mentira no ar.
#
# Para ligar o assistente: AGENT_PROVIDER=mastra + OPENAI_API_KEY.
AGENT_PROVIDER=fake
OPENAI_API_KEY=
AGENT_MODEL=openai/gpt-4o-mini
# Teto de gasto por empresa, em centavos. Vazio = sem teto configurado.
AGENT_MONTHLY_BUDGET_CENTS=


# --- Worker: emissao fiscal --------------------------------------------------
#
# `homologacao` emite nota SEM VALOR FISCAL. Trocar para `producao` emite nota
# de verdade, para a Receita — nao mude antes de o certificado e o credenciamento
# estarem certos.
FISCAL_PROVIDER=fake
FISCAL_AMBIENTE=homologacao


# --- Acesso provisorio ao painel da lista de espera (NR-112) -----------------
#
# Antes de existir o primeiro Super Admin, quem manda esta chave no cabecalho
# `x-waitlist-admin-key` entra em /admin/lista-vip sem sessao. Deixe VAZIA
# assim que houver Super Admin de verdade — e uma porta a menos.
#
#   openssl rand -base64 32
WAITLIST_ADMIN_KEY=


# =============================================================================
# Depois de preencher, e antes do primeiro acesso
# =============================================================================
#
# 1. Migrations NAO rodam sozinhas. Nenhum container as aplica — a imagem da
#    api sobe direto com `pnpm start`. Num banco novo, as tabelas nao existem:
#
#      pnpm db:migrate
#
# 2. O primeiro Super Admin nao nasce do nada (ADR-0007). Crie a conta pelo
#    site e promova:
#
#      pnpm db:super-admin voce@empresa.com.br
#
# 3. Confira que a api subiu de verdade:
#
#      curl https://api.eibuddy.com.br/health
#
#    502 = o container nao esta escutando; veja o motivo em
#    `docker compose -f infra/docker-compose.prod.yml logs api`.
